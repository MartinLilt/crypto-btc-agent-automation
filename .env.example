
# ── Binance API credentials ──────────────────────────────────────────────
# Market data (klines / ticker) is PUBLIC and needs no keys.
# Keys are only required when TRADING_MODE=live (real orders).
# Create keys at: https://www.binance.com/en/my/settings/api-management
# SECURITY: a bot key must have "Enable Withdrawals" turned OFF. IP whitelist recommended.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Trading mode ─────────────────────────────────────────────────────────
# paper : simulate orders locally on a virtual balance using REAL market data.
#         No keys needed, no real money at risk. Use this until the strategy
#         is proven.
# live  : place REAL spot orders on the account tied to the keys above.
TRADING_MODE=paper

# Real production trading API. Only used when TRADING_MODE=live.
BINANCE_TESTNET=false

# ── Instrument & data ────────────────────────────────────────────────────
SYMBOL=LTCUSDC       # traded pair (may be overridden by the target screener)
QUOTE_ASSET=USDC     # quote currency (USDC in the EU — USDT is MiCA-restricted)
INTERVAL=1h          # 1m, 5m, 15m, 1h, 4h, 1d ...
CANDLE_LIMIT=200     # candles per request (max 1000)

# ── Target-coin selector (runs FIRST, picks what to trade) ───────────────
# Universe screened to find the most promising coin for our system.
# AUTO_UNIVERSE=true builds the list live from the top coins by 24h volume
# (liquidity-filtered); TARGET_COINS is the fallback when it's false/unreachable.
# Grid-stream (bear cycle): curated blue-chips only — their bags reliably
# recover, so bag-and-feast is safe. Keep AUTO_UNIVERSE OFF during the bear
# (it pulls small-caps whose bags may never return); widen it in a bull cycle.
AUTO_UNIVERSE=false        # true = live top-volume universe, false = TARGET_COINS
UNIVERSE_SIZE=30           # how many coins in the live universe (bull only)
MIN_QUOTE_VOLUME=20000000  # min 24h volume (USDT) to include a coin — liquidity filter
TARGET_COINS=BTCUSDC,ETHUSDC,BNBUSDC,SOLUSDC,XRPUSDC
AUTO_TARGET=true           # true = runner auto-picks the target and ignores SYMBOL
TARGET_SCREEN_INTERVAL=1d  # timeframe to JUDGE coins on (daily = reads trend right)
TARGET_SCREEN_LIMIT=365    # candles per coin during screening (365d = 1 year)

# ── Strategy switch ──────────────────────────────────────────────────────
# sma : SMA crossover  (trend following, calm)
# ema : EMA crossover  (trend following, reacts faster)
# rsi : RSI reversion  (buy oversold, sell overbought)
STRATEGY=sma
AUTO_STRATEGY=true   # true = system auto-picks the best strategy for the coin
                     # (STRATEGY above is only used as a fallback)

# SMA crossover params
SMA_FAST=20
SMA_SLOW=50

# EMA crossover params
EMA_FAST=12
EMA_SLOW=26

# RSI reversion params
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Breakout (Donchian) params
BREAKOUT_PERIOD=20   # buy above N-bar high, sell below N-bar low

# ── Exit management (legacy single-position mode) ────────────────────────
# Percentages; 0 disables. Checked every bar before the strategy.
TAKE_PROFIT_PCT=0     # exit at +X%
STOP_LOSS_PCT=0       # exit at -X%
TRAILING_STOP_PCT=0   # exit X% below the peak since entry
MAX_HOLD_BARS=0       # force-exit after N bars

# ── Grid-stream (the live strategy) — MANY config (risk-controlled) ──────
# Drips a micro take-profit "stream", accumulates bags on dips (uptrend only),
# holds frozen bags for the bull-cycle feast. No stop-loss by design.
# Small units + tight step deploy LESS capital = far lower drawdown (2025 bear:
# −3% vs −16% with big units), steady smaller stream. unit ≈ 0.4% of balance;
# keep unit ≥ Binance min-notional (~$10) when going live.
GRID_TP_PCT=0.6       # micro take-profit per bag (net-positive after fees)
GRID_STEP_PCT=0.5     # add a bag when price drops this % below the lowest bag
GRID_UNIT_USDT=10     # USDT per bag (Binance min-notional real; keep ≈0.4% of balance)
GRID_MAX_BAGS=40      # max concurrent bags per coin
GRID_SMA=100          # uptrend filter — no new bags while price is below it

# ── Market regime (tendency) detector ────────────────────────────────────
# Classifies the market as BULL / NEUTRAL / BEAR before a strategy acts.
# Multi-timeframe: measure the trend on a HIGHER timeframe than we trade on
# (e.g. trade INTERVAL=1h but read the regime on REGIME_INTERVAL=1d).
REGIME_INTERVAL=1d        # timeframe the regime is measured on
REGIME_MA=50              # long SMA window used to read the trend
REGIME_SLOPE_LOOKBACK=10  # candles back to measure the MA's slope
REGIME_FLAT_PCT=2.0       # |slope%| below this = flat = NEUTRAL
REGIME_GATE=true          # true = adapt strategy to regime; false = ignore it

# ── Order sizing ─────────────────────────────────────────────────────────
QUOTE_ORDER_QTY=20   # USDT spent per BUY (spot only, no leverage)
FEE_RATE=0.001       # Binance taker fee per side (0.1%) — charged on buy AND sell

# ── Tax (Lithuania) ──────────────────────────────────────────────────────
# Net take-profit = gross - Binance fees - tax. Tax hits only positive P&L
# above the yearly allowance. Defaults ≈ Lithuania GPM. NOT tax advice —
# confirm current rates with the STI / an accountant.
TAX_RATE=0.15        # 15% personal income tax (GPM) on capital gains
TAX_ALLOWANCE=500    # yearly tax-free amount on disposals, EUR

# ── Paper simulator ──────────────────────────────────────────────────────
PAPER_START_BALANCE=2500   # virtual USDT the paper account starts with
# ── Telegram output (results notifications) ──────────────────────────────
# Create a bot via @BotFather, message it once, then read chat_id from
# https://api.telegram.org/bot<token>/getUpdates. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Multi-account (one bot trading several accounts) ─────────────────────
# Each account trades its OWN Binance keys, on its OWN state (slot). Reports
# are pushed by DM to whitelisted Telegram users who press Start on the bot.
#
# Whitelist: only these @usernames may subscribe to reports (comma-separated,
# case-insensitive, with or without @). Everyone else who messages the bot is
# refused. Leave empty to keep the legacy single-recipient (TELEGRAM_CHAT_ID).
TELEGRAM_WHITELIST=          # e.g. AleksandLi,limi_amm
#
# Account 1 = primary (uses BINANCE_API_KEY/SECRET above, state slot 1 = existing).
ACCOUNT_1_NAME=Grid-stream   # display label in the report header
ACCOUNT_1_TG=                # owner's @username (shown in the header)
#
# Account 2 = second trader (state slot 2). Declared once ACCOUNT_2_TG is set;
# stays INACTIVE (skipped, observer-only) until its keys are filled in. The key
# must whitelist the SAME Railway static egress IPs and have Withdrawals OFF.
ACCOUNT_2_NAME=
ACCOUNT_2_TG=
BINANCE_API_KEY_2=
BINANCE_API_SECRET_2=

# Regime-adaptive strategy (BEAR=defend · NEUTRAL=grid · BULL=hold&ride)
REGIME_ADAPTIVE=true

# BULL mode: capital fraction to buy-&-hold per coin when it is in BULL (rides the trend)
# 0.15 -> 0.25 on 2026-08-22: attribution (backtest/portfolio.py) showed the hold
# sleeve earns 38.6%/yr per deployed dollar vs the grid's 8.7%, and raising this is
# monotone in BOTH disjoint halves (full +28.0% -> +49.9%, H2 +8.3% -> +15.9%).
# Cost: max drawdown 21.4% -> 31.0%. 0.35 gives +63.4% at a 35.6% drawdown.
BULL_HOLD_PCT=0.25

# ── Storage ──────────────────────────────────────────────────────────────
# Postgres DSN. Empty → atomic JSON file (state/grid_state.json + trades.jsonl).
# On Railway this is auto-set to the Postgres service via a reference variable.
DATABASE_URL=

# ══════════════════════════════════════════════════════════════════════════
# LIVE TEST (~$22 USDC) — set these on Railway to smoke-test real execution.
# USDC min-notional is $5, so unit $6 fits ~3 bags; hold 0.30×$22≈$6.6 > $5.
# (Keep the strategy defaults above for the real, scaled run.)
#   TRADING_MODE=live
#   BINANCE_API_KEY=...        # withdrawals OFF, IP-whitelist recommended
#   BINANCE_API_SECRET=...
#   GRID_UNIT_USDT=6
#   BULL_HOLD_PCT=0.30
# ══════════════════════════════════════════════════════════════════════════
