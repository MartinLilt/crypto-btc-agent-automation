[Unit]
Description=Fire grid-stream every 4 hours (replaces Railway cron 0 */4 * * *)

[Timer]
OnCalendar=*-*-* 00/4:00:00
# A run missed while the box was down fires once on boot rather than being
# skipped to the next 4h slot — the strategy tolerates a late cycle, not a lost
# one. RandomizedDelay keeps us off the exact minute every other Binance bot
# uses.
Persistent=true
RandomizedDelaySec=120
Unit=grid-stream.service

[Install]
WantedBy=timers.target
